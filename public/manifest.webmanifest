{
  "name": "Bambu → Snapmaker U1 Converter",
  "short_name": "U1 Converter",
  "description": "Convert Bambu Studio filament presets and .3mf projects for the Snapmaker U1",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f5f2",
  "theme_color": "#0f6b5c",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./#projects", "accept": { "model/3mf": [".3mf"] } }
  ]
}
